{
  "id": "bsshs-semiconductor",
  "title": "반도체와 다이오드 정류 회로",
  "unit": "semiconductor",
  "formulas": [
    {
      "key": "ideal_diode",
      "name": "이상적인 다이오드 모델",
      "expr": "순방향: V_D = 0(닫힌 스위치), 역방향: I_D = 0(열린 스위치)",
      "tex": "V_D = 0\\ (\\text{순방향}),\\qquad I_D = 0\\ (\\text{역방향})",
      "variables": [
        {
          "key": "diodeVoltage",
          "symbol": "V_D",
          "name": "다이오드 양단 전압",
          "unit": "V"
        },
        {
          "key": "diodeCurrent",
          "symbol": "I_D",
          "name": "다이오드 전류",
          "unit": "A"
        }
      ],
      "emphasis": true,
      "outOfScope": false
    },
    {
      "key": "constant_drop_model",
      "name": "고정 전압 강하 모델",
      "expr": "V_D = V_on,  I_D = (V_s − V_on)/R",
      "tex": "V_D = V_{\\text{on}},\\qquad I_D = \\frac{V_s - V_{\\text{on}}}{R}",
      "variables": [
        {
          "key": "diodeVoltage",
          "symbol": "V_D",
          "name": "다이오드 양단 전압",
          "unit": "V"
        },
        {
          "key": "diodeCurrent",
          "symbol": "I_D",
          "name": "다이오드 전류",
          "unit": "A"
        },
        {
          "key": "sourceVoltage",
          "symbol": "V_s",
          "name": "전원 전압",
          "unit": "V"
        },
        {
          "key": "turnOnVoltage",
          "symbol": "V_on",
          "name": "문턱(턴온) 전압",
          "unit": "V"
        },
        {
          "key": "loadResistance",
          "symbol": "R",
          "name": "부하 저항",
          "unit": "Ω"
        }
      ],
      "emphasis": true,
      "outOfScope": false,
      "note": "참고: 실리콘 다이오드는 V_on ≈ 0.7 V를 흔히 쓴다. V_s < V_on이면 전류가 흐르지 않는다."
    },
    {
      "key": "piecewise_linear_model",
      "name": "구간 선형 모델",
      "expr": "V_D = V_on + I_D r_d,  I_D = (V_s − V_on)/(R + r_d)",
      "tex": "V_D = V_{\\text{on}} + I_D\\,r_d,\\qquad I_D = \\frac{V_s - V_{\\text{on}}}{R + r_d}",
      "variables": [
        {
          "key": "diodeVoltage",
          "symbol": "V_D",
          "name": "다이오드 양단 전압",
          "unit": "V"
        },
        {
          "key": "diodeCurrent",
          "symbol": "I_D",
          "name": "다이오드 전류",
          "unit": "A"
        },
        {
          "key": "turnOnVoltage",
          "symbol": "V_on",
          "name": "문턱(턴온) 전압",
          "unit": "V"
        },
        {
          "key": "diodeResistance",
          "symbol": "r_d",
          "name": "다이오드의 기울기 저항",
          "unit": "Ω"
        },
        {
          "key": "sourceVoltage",
          "symbol": "V_s",
          "name": "전원 전압",
          "unit": "V"
        },
        {
          "key": "loadResistance",
          "symbol": "R",
          "name": "부하 저항",
          "unit": "Ω"
        }
      ],
      "emphasis": true,
      "outOfScope": false,
      "note": "참고: 턴온 뒤의 전류-전압 곡선을 직선으로 근사한다. 기울기가 일정하다는 것은 저항 r_d가 일정하다는 뜻이다."
    },
    {
      "key": "half_wave_output",
      "name": "반파 정류 출력",
      "expr": "v_out = v_in − V_on (v_in > V_on), 그 밖에는 0",
      "tex": "v_{\\text{out}} = \\begin{cases} v_{\\text{in}} - V_{\\text{on}} & (v_{\\text{in}} > V_{\\text{on}}) \\\\ 0 & (\\text{그 밖}) \\end{cases}",
      "variables": [
        {
          "key": "outputVoltage",
          "symbol": "v_out",
          "name": "출력 전압",
          "unit": "V"
        },
        {
          "key": "inputVoltage",
          "symbol": "v_in",
          "name": "입력 전압",
          "unit": "V"
        },
        {
          "key": "turnOnVoltage",
          "symbol": "V_on",
          "name": "문턱(턴온) 전압",
          "unit": "V"
        }
      ],
      "emphasis": false,
      "outOfScope": false
    },
    {
      "key": "bridge_output",
      "name": "브리지(전파) 정류 출력",
      "expr": "v_out = |v_in| − 2V_on (|v_in| > 2V_on), 그 밖에는 0",
      "tex": "v_{\\text{out}} = \\begin{cases} |v_{\\text{in}}| - 2V_{\\text{on}} & (|v_{\\text{in}}| > 2V_{\\text{on}}) \\\\ 0 & (\\text{그 밖}) \\end{cases}",
      "variables": [
        {
          "key": "outputVoltage",
          "symbol": "v_out",
          "name": "출력 전압",
          "unit": "V"
        },
        {
          "key": "inputVoltage",
          "symbol": "v_in",
          "name": "입력 전압",
          "unit": "V"
        },
        {
          "key": "turnOnVoltage",
          "symbol": "V_on",
          "name": "문턱(턴온) 전압",
          "unit": "V"
        }
      ],
      "emphasis": false,
      "outOfScope": false,
      "note": "참고: 브리지에서는 전류가 늘 다이오드 두 개를 지나므로 전압 강하도 두 번 생긴다."
    },
    {
      "key": "ripple_voltage",
      "name": "평활 축전기의 리플 전압",
      "expr": "ΔV ≈ V_p/(fRC) (반파), ΔV ≈ V_p/(2fRC) (브리지)",
      "tex": "\\Delta V \\approx \\frac{V_p}{f R C}\\ (\\text{반파}),\\qquad \\Delta V \\approx \\frac{V_p}{2 f R C}\\ (\\text{브리지})",
      "variables": [
        {
          "key": "rippleVoltage",
          "symbol": "ΔV",
          "name": "리플 전압",
          "unit": "V"
        },
        {
          "key": "peakVoltage",
          "symbol": "V_p",
          "name": "출력의 최대 전압",
          "unit": "V"
        },
        {
          "key": "signalFrequency",
          "symbol": "f",
          "name": "입력 교류의 진동수",
          "unit": "Hz"
        },
        {
          "key": "loadResistance",
          "symbol": "R",
          "name": "부하 저항",
          "unit": "Ω"
        },
        {
          "key": "capacitance",
          "symbol": "C",
          "name": "평활 축전기의 전기 용량",
          "unit": "F"
        }
      ],
      "emphasis": false,
      "outOfScope": false,
      "note": "참고: 시간 상수 RC가 주기보다 훨씬 길어서 방전을 직선으로 볼 수 있을 때의 근사이다."
    },
    {
      "key": "shockley_equation",
      "name": "다이오드 전류-전압 관계(쇼클리 식)",
      "expr": "I_D = I_s(e^(V_D/(n·kT/e)) − 1)",
      "tex": "I_D = I_s\\left(e^{V_D/(n k T/e)} - 1\\right)",
      "variables": [
        {
          "key": "diodeCurrent",
          "symbol": "I_D",
          "name": "다이오드 전류",
          "unit": "A"
        },
        {
          "key": "saturationCurrent",
          "symbol": "I_s",
          "name": "역방향 포화 전류",
          "unit": "A"
        },
        {
          "key": "diodeVoltage",
          "symbol": "V_D",
          "name": "다이오드 양단 전압",
          "unit": "V"
        },
        {
          "key": "idealityFactor",
          "symbol": "n",
          "name": "이상 계수",
          "unit": ""
        },
        {
          "key": "temperature",
          "symbol": "T",
          "name": "절대 온도",
          "unit": "K"
        },
        {
          "key": "boltzmannConstant",
          "symbol": "k",
          "name": "볼츠만 상수",
          "unit": "J/K",
          "constant": 1.380649e-23
        },
        {
          "key": "elementaryCharge",
          "symbol": "e",
          "name": "기본 전하량",
          "unit": "C",
          "constant": 1.602176634e-19
        }
      ],
      "emphasis": false,
      "outOfScope": false,
      "note": "참고: 수업에서 다루지 않은 표준 보충이다. 이상적·고정 전압·구간 선형 모델은 모두 이 곡선을 단순하게 근사한 것이다."
    },
    {
      "key": "built_in_voltage",
      "name": "p-n 접합의 내부 전위차",
      "expr": "V_bi = (kT/e) ln(N_A N_D / n_i²)",
      "tex": "V_{\\text{bi}} = \\frac{kT}{e}\\ln\\frac{N_A N_D}{n_i^2}",
      "variables": [
        {
          "key": "builtInVoltage",
          "symbol": "V_bi",
          "name": "내부 전위차",
          "unit": "V"
        },
        {
          "key": "temperature",
          "symbol": "T",
          "name": "절대 온도",
          "unit": "K"
        },
        {
          "key": "acceptorDensity",
