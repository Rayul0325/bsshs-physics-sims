          "name": "p쪽 억셉터 농도",
          "unit": "m⁻³"
        },
        {
          "key": "donorDensity",
          "symbol": "N_D",
          "name": "n쪽 도너 농도",
          "unit": "m⁻³"
        },
        {
          "key": "intrinsicDensity",
          "symbol": "n_i",
          "name": "고유 운반자 농도",
          "unit": "m⁻³"
        },
        {
