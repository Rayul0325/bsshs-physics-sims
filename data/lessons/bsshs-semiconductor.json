        },
        {
          "key": "elementaryCharge",
          "symbol": "e",
          "name": "기본 전하량",
          "unit": "C",
          "constant": 1.602176634e-19
        }
      ],
      "emphasis": false,
      "outOfScope": false,
      "note": "참고: 수업에서 식으로 다루지 않은 표준 보충이다. 순방향(V_D > 0)이면 좁아지고 역방향(V_D < 0)이면 넓어진다. W²이 V_D에 대해 직선이다."
    }
  ],
  "terms": [
    {
      "term": "에너지 띠",
      "definition": "원자가 많이 모인 고체에서 각 원자의 에너지 준위가 촘촘히 갈라져 이룬 띠이다. 띠가 채워진 정도와 띠 사이 간격이 전기 전도성을 정한다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "띠 간격",
      "definition": "원자가 띠와 전도 띠 사이의 에너지 간격이다. 부도체는 크고, 반도체는 작아서 열이나 도핑으로 전하 운반자를 늘릴 수 있다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "도체, 부도체, 반도체",
      "definition": "도체는 띠 안에 전자가 움직일 빈자리가 있고, 부도체는 큰 띠 간격을 넘어야 한다. 반도체는 그 중간이다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "도핑",
      "definition": "순수한 반도체에 다른 원소를 조금 섞어 전하 운반자를 늘리는 것이다. 도핑한 뒤에도 반도체 전체는 전기적으로 중성이다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "n형 반도체",
      "definition": "실리콘보다 원자가 전자가 하나 많은 원소를 섞어 움직이기 쉬운 전자가 생긴 반도체이다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "p형 반도체와 양공",
      "definition": "붕소처럼 원자가 전자가 하나 적은 원소를 섞은 반도체이다. 전자가 빠진 자리인 양공이 양전하처럼 움직인다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "공핍층",
      "definition": "p-n 접합면 근처에서 전자와 양공이 결합해 전하 운반자가 거의 없는 영역이다. 전위 장벽이 생긴다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "순방향 바이어스와 역방향 바이어스",
      "definition": "p쪽에 높은 전압을 걸면 장벽이 낮아져 전류가 흐르고(순방향), 반대로 걸면 장벽이 높아져 전류가 거의 흐르지 않는다(역방향).",
      "emphasis": true,
      "outOfScope": false
    },
    {
      "term": "문턱 전압",
      "definition": "실제 다이오드에서 전류가 본격적으로 흐르기 시작하는 순방향 전압이다. 실리콘은 약 0.7 V이다.",
      "emphasis": true,
      "outOfScope": false
    },
    {
      "term": "항복",
      "definition": "역방향 전압이 지나치게 크면 큰 전류가 갑자기 흘러 소자가 망가질 수 있는 현상이다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "정류",
      "definition": "교류를 한 방향으로만 흐르는 전류로 바꾸는 것이다. 다이오드 하나로 반파 정류, 다이오드 네 개(브리지)로 전파 정류를 한다.",
      "emphasis": true,
      "outOfScope": false
    },
    {
      "term": "평활 축전기와 리플",
      "definition": "정류 출력에 축전기를 연결하면 충전과 방전으로 출력이 고르게 된다. 남은 흔들림을 리플 전압이라고 한다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "오실로스코프 공통 접지",
      "definition": "함수 발생기와 오실로스코프의 접지는 서로 연결되어 있으므로, 측정점을 잘못 고르면 회로 일부가 단락되어 파형이 제대로 나오지 않는다.",
      "emphasis": true,
      "outOfScope": false
    },
    {
      "term": "홀 효과",
      "definition": "자기장 속에서 전류가 흐르는 반도체의 양옆에 전압이 생기는 현상이다. 이 전압의 부호로 전하 운반자가 전자인지 양공인지 알 수 있다.",
      "emphasis": false,
      "outOfScope": false
    }
  ],
