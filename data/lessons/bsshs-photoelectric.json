  "terms": [
    {
      "term": "광전 효과",
      "definition": "금속에 진동수가 충분히 큰 빛을 비추면 전자가 튀어나오는 현상이다. 빛이 광자라는 입자처럼 행동한다는 증거이다.",
      "emphasis": true,
      "outOfScope": false
    },
    {
      "term": "광전자",
      "definition": "빛을 받아 금속에서 튀어나온 전자이다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "광전류",
      "definition": "광전자가 한 방향으로 움직이며 만드는 전류이다. 문턱 진동수 이상에서는 빛이 셀수록 커진다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "일함수",
      "definition": "금속에서 전자 하나를 떼어 내는 데 필요한 최소 에너지이다. 금속마다 값이 다르다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "문턱 진동수",
      "definition": "광전자를 튀어나오게 할 수 있는 빛의 최소 진동수이다. 이보다 낮으면 빛이 아무리 세도 광전자가 나오지 않는다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "정지 전압",
      "definition": "역방향 전압을 높여 광전류가 0이 될 때의 전압이다. 가장 빠른 광전자도 되돌려 보낼 만큼의 전압이다.",
      "emphasis": false,
      "outOfScope": false
    },
    {
      "term": "빛의 세기와 광자 수",
      "definition": "빛의 세기는 광자의 수와 관련되고, 광자 한 개의 에너지는 진동수로만 정해진다. 그래서 세기는 광전류에만 영향을 주고 최대 운동 에너지는 바꾸지 못한다.",
      "emphasis": true,
      "outOfScope": false
    },
    {
      "term": "여러 빛을 함께 비출 때",
      "definition": "진동수가 다른 빛을 함께 비추면 광자마다 광전 효과 식을 따로 세운다.",
      "emphasis": true,
      "outOfScope": false
    }
  ],
